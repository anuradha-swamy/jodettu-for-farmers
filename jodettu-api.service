[Unit]
Description=Jodettu API Server
After=network.target postgresql.service
Requires=postgresql.service

[Service]
Type=exec
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/Jodettu
Environment=PATH=/home/ubuntu/Jodettu/venv/bin
Environment=PYTHONPATH=/home/ubuntu/Jodettu
Environment=DATABASE_URL=postgresql://jodettu_user:jodettu_password@localhost:5432/jodettu_db
ExecStart=/home/ubuntu/Jodettu/venv/bin/python -m uvicorn main_production:app --host 0.0.0.0 --port 8000
ExecReload=/bin/kill -HUP $MAINPID
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=jodettu-api

# Security settings
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/log/jodettu-api /home/ubuntu/Jodettu/upload_files

[Install]
WantedBy=multi-user.target
